{
  "name": "owners-hub",
  "productName": "The Owners Hub",
  "version": "1.0.0",
  "description": "Your garage, kept. Service schedules, history, MOT and reminders for all your cars.",
  "author": "The Owners Hub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ownershub.app",
    "productName": "The Owners Hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "The Owners Hub",
      "artifactName": "The-Owners-Hub-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}